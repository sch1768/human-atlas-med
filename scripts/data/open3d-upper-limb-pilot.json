  "adaptations": [
    {
      "structure": "axillary nerve and superior lateral cutaneous nerve of arm",
      "method": "Feathered radial contraction toward the BodyParts3D humeral axis, limited to the lateral shoulder segment",
      "reason": "Keep the post-quadrangular-space course close to the surgical neck and deep surface of the deltoid while preserving the medial origin",
      "references": [
        "https://www.ncbi.nlm.nih.gov/books/NBK493212/",
        "https://pubmed.ncbi.nlm.nih.gov/9381311/"
      ]
    },
    {
      "structure": "ulnar nerve",
      "method": "Feathered anterior path offsets immediately distal to the cubital tunnel",
      "reason": "Move the proximal forearm segment between the flexor carpi ulnaris heads and onto the anterior surface of flexor digitorum profundus while preserving the retro-epicondylar segment",
      "references": [
        "https://www.ncbi.nlm.nih.gov/books/NBK431063/",
        "https://www.ncbi.nlm.nih.gov/books/NBK526051/"
      ]
    },
    {
      "structure": "palmar and digital nerves",
      "method": "Distal-only path compression with a small palmar depth correction while preserving proximal branch junctions",
      "reason": "Terminate digital branches within the fingertip pads and keep palmar branches beside the digital vessels rather than beyond the distal phalanges",
      "references": ["https://www.ncbi.nlm.nih.gov/books/NBK546684/"]
    },
    {
      "structure": "brachial plexus roots, trunks, and divisions",
      "method": "Posterior depth offset limited to the interscalene and supraclavicular segments",
      "reason": "Keep the roots and trunks deep to the cervical fascia between the anterior and middle scalene muscles",
      "references": ["https://www.ncbi.nlm.nih.gov/books/NBK544222/"]
    },
    {
      "structure": "superficial cervical plexus and accessory nerve",
      "method": "Project-authored tubular paths registered to the BodyParts3D SCM, clavicle, and trapezius landmarks",
      "reason": "The selected BodyParts3D and Open3DModel upper-limb sources do not contain these structures as separable meshes",
      "references": ["https://www.ncbi.nlm.nih.gov/books/NBK551521/"]
    },
    {
      "structure": "subclavian, axillary, and terminal cephalic veins",
      "method": "Viewer-side posterior depth correction restricted to the clavicular segment",
      "reason": "Prevent the terminal venous junction from projecting through the pectoral surface while retaining the subclavian vein anterior to the anterior scalene",
      "references": ["https://www.ncbi.nlm.nih.gov/books/NBK545247/"]
    }
  ],
